{
  "schemaVersion": 1,
  "contract": "FeishuPresentation",
  "commonContractRefs": [
    {
      "file": "common-contract-vectors.json",
      "pointer": "replyOutcomes"
    },
    {
      "file": "common-contract-vectors.json",
      "pointer": "deliverySettlements"
    }
  ],
  "presenceLifecycle": {
    "beginAfter": "durable_acceptance",
    "keepActiveDuring": [
      "queued",
      "run_started",
      "card_opened",
      "progress",
      "elapsed_over_120_seconds",
      "delivery_unknown"
    ],
    "settlements": [
      {
        "intent": "answer",
        "on": [
          "platform_accepted",
          "reconciled"
        ],
        "presence": "finished"
      },
      {
        "intent": "failure_notice",
        "on": [
          "platform_accepted",
          "reconciled"
        ],
        "presence": "finished"
      },
      {
        "intent": "task_receipt",
        "on": [
          "platform_accepted",
          "reconciled"
        ],
        "presence": "finished"
      },
      {
        "intent": "silent",
        "on": [
          "suppressed"
        ],
        "presence": "finished"
      },
      {
        "intent": "cancelled",
        "on": [
          "cancelled_confirmed"
        ],
        "presence": "finished"
      },
      {
        "intent": "any",
        "on": [
          "unknown"
        ],
        "presence": "active",
        "next": "reconcile"
      },
      {
        "intent": "any",
        "on": [
          "delivery_exhausted"
        ],
        "presence": "finished_unpresentable",
        "alert": true,
        "delivered": false
      }
    ],
    "orphanRecovery": {
      "retryPresenceRemoval": true,
      "resendFinalReply": false
    }
  },
  "projection": {
    "owner": "feishu",
    "coalesceKey": [
      "requestId",
      "presentationId"
    ],
    "rateLimitWindowMs": {
      "minimum": 250,
      "maximum": 1000
    },
    "persisted": [
      "highWatermark",
      "lastAppliedSequence",
      "cardKitSequence"
    ],
    "terminalBarrier": {
      "trailingFlush": true,
      "blocksFinalIntent": false
    },
    "projectionFailureCreatesRunFailed": false,
    "duplicateCreatesCard": false,
    "duplicateCreatesReaction": false,
    "progressAckScope": "consumer_route",
    "globalAck": false
  },
  "finalAdapter": {
    "physicalStore": "feishu-local",
    "sharedPhysicalOutboxWithHxa": false,
    "operations": [
      "attempt",
      "receipt",
      "reconcile",
      "retry",
      "dead_letter",
      "redrive"
    ],
    "unknownBeforeRetry": "reconcile",
    "redriveReuses": [
      "intentId",
      "deliveryId"
    ],
    "platformAcceptedMeansUserRead": false,
    "deliveryExhaustionChangesRunOutcome": false
  }
}
